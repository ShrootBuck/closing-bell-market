{
  "name": "closing-bell",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n srv,web \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server.mjs --external:bufferutil --external:utf-8-validate --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "start": "node dist/server.mjs",
    "sim": "tsx scripts/sim.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "canvas-confetti": "^1.9.4",
    "katex": "^0.19.1",
    "motion": "^14.14.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
